{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xyool.local/domains/stock-market/state/schemas/entity-state.schema.json",
  "title": "Xyool Stock Entity State",
  "type": "object",
  "required": [
    "schema_version",
    "domain",
    "entity_id",
    "identity",
    "state_version",
    "as_of",
    "current_state",
    "source_cursors"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "domain": {
      "const": "stock-market"
    },
    "entity_id": {
      "type": "string",
      "minLength": 1
    },
    "identity": {
      "type": "object"
    },
    "state_version": {
      "type": "integer",
      "minimum": 1
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "current_state": {
      "type": "object"
    },
    "source_cursors": {
      "type": "object"
    },
    "latest_material_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "active_timer_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "completeness_status": {
      "type": "string"
    },
    "dependency_graph": {
      "type": "object",
      "required": [
        "graph_version",
        "as_of",
        "nodes",
        "edges"
      ],
      "properties": {
        "graph_version": {
          "type": "integer",
          "minimum": 1
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "primary_gate_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "terminal_node_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "node_id",
              "label",
              "state",
              "satisfied"
            ],
            "properties": {
              "node_id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "node_type": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "satisfied": {
                "type": "boolean"
              },
              "evidence_status": {
                "type": "string"
              },
              "event_key": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "timer_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "expected_window": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "economic_role": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "materiality": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "invalidation": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "relationship": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "analyst_rationale": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "repricing_sensitivity": {
      "type": "object",
      "properties": {
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "price": {
          "type": [
            "number",
            "null"
          ]
        },
        "basic_shares": {
          "type": [
            "number",
            "null"
          ]
        },
        "basic_market_cap": {
          "type": [
            "number",
            "null"
          ]
        },
        "fully_diluted_shares": {
          "type": [
            "number",
            "null"
          ]
        },
        "fully_diluted_market_cap": {
          "type": [
            "number",
            "null"
          ]
        },
        "fully_diluted_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "enterprise_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "target_burdens": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "minimum_viable_catalyst": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "story_memory": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "latest_story_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "latest_story_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "story_as_of": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "story_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_authority": {
          "type": [
            "string",
            "null"
          ]
        },
        "closure_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "max_degree": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4
        },
        "compressed_story": {
          "type": [
            "string",
            "null"
          ]
        },
        "thesis": {
          "type": [
            "string",
            "null"
          ]
        },
        "primary_conflict": {
          "type": [
            "string",
            "null"
          ]
        },
        "primary_bottleneck": {
          "type": [
            "string",
            "null"
          ]
        },
        "likely_next_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "conditional_window": {
          "type": [
            "string",
            "null"
          ]
        },
        "primary_invalidation": {
          "type": [
            "string",
            "null"
          ]
        },
        "key_characters": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "relationship_graph": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "relationship_deltas": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "local_web_heads": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "newly_entered_characters": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "ended_relationships": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "story_policy_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "material_source_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_refresh_targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "story_reader_head": {
          "type": "object"
        },
        "story_writer_head": {
          "type": "object"
        },
        "future_branches": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "counter_story_branches": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "next_observable_proofs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "writer_freeze_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "character_profile_heads": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    },
    "analysis_memory": {
      "type": "object",
      "properties": {
        "latest_analysis_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "latest_analysis_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "latest_analysis_as_of": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "material_conclusions": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "unmapped_material_conclusions": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "completeness_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "archive_origin": {
          "type": [
            "string",
            "null"
          ]
        },
        "lossless_original": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "historical_limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "filing_memory": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "recent_filings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "latest_by_family": {
          "type": "object"
        },
        "signal_heads": {
          "type": "object"
