        },
        "decision_arm": {
          "type": [
            "string",
            "null"
          ]
        },
        "baseline_method": {
          "type": [
            "string",
            "null"
          ]
        },
        "augmented_method": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome_reveal_status": {
          "type": [
            "string",
