            "NONE",
            "SINGLE_SIGNAL",
            "INSIDER_PLUS_TRANSITION",
            "MULTI_SOURCE_CONFLUENCE",
            "TRANSITION_WITH_CAPTURE_RISK",
            "RISK_ONLY"
          ]
