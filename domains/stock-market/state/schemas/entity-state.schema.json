          "type": "object"
        },
        "deep_analysis_required": {
          "type": "boolean"
        },
        "deep_analysis_trigger_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "latest_accession": {
          "type": [
            "string",
            "null"
          ]
        },
        "latest_form": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_ingested_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": true
    },
    "research_shadow_state": {
      "type": "object",
      "properties": {
        "as_of": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "method_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "expectations_diffusion": {
          "type": "object"
        },
        "factor_neutral_recognition": {
          "type": "object"
        },
        "execution_capacity": {
          "type": "object"
        },
        "short_feasibility": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "research_trial_context": {
      "type": "object",
      "properties": {
        "trial_id": {
          "type": [
            "string",
